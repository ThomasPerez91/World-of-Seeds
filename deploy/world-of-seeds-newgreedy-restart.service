[Unit]
Description=World of Seeds restricted NewGreedy restart
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/world-of-seeds-newgreedy-restart
RuntimeDirectory=world-of-seeds-newgreedy
RuntimeDirectoryMode=0700
UMask=0027
TimeoutStartSec=150
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/seedbox/.wos-control/newgreedy
ReadWritePaths=/srv/seedbox/.wos-control/newgreedy-status
ReadWritePaths=/run/world-of-seeds-newgreedy
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
SystemCallArchitectures=native


[Unit]
Description=Daily World of Seeds V2 encrypted account export

[Timer]
# After the 03:30 UTC PostgreSQL backup and its isolated restore check.
OnCalendar=*-*-* 04:30:00 UTC
Persistent=true
RandomizedDelaySec=10min
Unit=world-of-seeds-v2-accounts-backup.service

[Install]
WantedBy=timers.target

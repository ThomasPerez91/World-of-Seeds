#!/usr/bin/env bash
set -Eeuo pipefail

readonly PROJECT_DIR="/opt/world-of-seeds-v2"
readonly ENV_FILE="/etc/world-of-seeds-v2/environment"
readonly COMPOSE_FILE="${PROJECT_DIR}/deploy/compose.rise2.v2.yaml"
readonly IMAGE_REPOSITORY="ghcr.io/thomasperez91/world-of-seeds-v2"
readonly STATE_DIR="/var/lib/world-of-seeds-v2/deploy"
readonly STATE_FILE="${STATE_DIR}/current.env"
readonly DATA_MOUNT="/srv/world-of-seeds-v2/data"

DOCKER_CONFIG_DIR=""
ENV_BACKUP=""
PREVIOUS_REVISION=""
PREVIOUS_IMAGE=""
PREVIOUS_DB_HEAD=""
TARGET_REVISION=""
TARGET_IMAGE=""
MIGRATION_STARTED=0
MIGRATION_APPLIED=0
PREVIOUS_SCHEMA=""
TARGET_DB_HEAD=""
MIGRATION_MODE="same"
BACKUP_HELPER=""
BACKUP_LOG=""
PRESERVE_RECOVERY=0
RUNTIME_CHANGED=0
ROLLBACK_ENABLED=0
COMPOSE=()

fail() {
  printf 'Erreur déploiement Rise2: %s\n' "$*" >&2
  if [[ "${ROLLBACK_ENABLED}" == "1" ]]; then
    rollback 1
  fi
  exit 1
}

cleanup() {
  if [[ -n "${DOCKER_CONFIG_DIR}" && -d "${DOCKER_CONFIG_DIR}" ]]; then
    rm -rf -- "${DOCKER_CONFIG_DIR}"
  fi
  if [[ -n "${BACKUP_HELPER}" && -e "${BACKUP_HELPER}" ]]; then
    rm -f -- "${BACKUP_HELPER}"
  fi
  if [[ "${PRESERVE_RECOVERY}" != "1" && -n "${ENV_BACKUP}" && -e "${ENV_BACKUP}" ]]; then
    rm -f -- "${ENV_BACKUP}"
  fi
}

repo_git() {
  git -c safe.directory="${PROJECT_DIR}" -C "${PROJECT_DIR}" "$@"
}

env_value() {
  local key="$1"
  python3 - "${ENV_FILE}" "${key}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
key = sys.argv[2]
prefix = key + "="
value = None
for raw in path.read_text(encoding="utf-8").splitlines():
    if raw.startswith(prefix):
        value = raw[len(prefix):].strip()
if value is None:
    raise SystemExit(f"missing environment key: {key}")
if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
    value = value[1:-1]
print(value)
PY
}

set_env_image() {
  local image="$1"
  python3 - "${ENV_FILE}" "${image}" <<'PY'
from pathlib import Path
import os
import sys
import tempfile

path = Path(sys.argv[1])
image = sys.argv[2]
st = path.stat()
lines = path.read_text(encoding="utf-8").splitlines()
out = []
found = False
for line in lines:
    if line.startswith("WOS_V2_IMAGE="):
        out.append("WOS_V2_IMAGE=" + image)
        found = True
    else:
        out.append(line)
if not found:
    raise SystemExit("WOS_V2_IMAGE missing")
fd, tmp = tempfile.mkstemp(prefix=".environment.", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write("\n".join(out) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(tmp, st.st_mode & 0o777)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

container_health() {
  local service="$1"
  local cid
  cid="$("${COMPOSE[@]}" ps -q "${service}")"
  [[ -n "${cid}" ]] || return 1
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${cid}"
}

write_state() {
  local tmp
  install -d -m 700 -o root -g root "${STATE_DIR}"
  tmp="$(mktemp "${STATE_DIR}/.current.XXXXXX")"
  chmod 600 "${tmp}"
  {
    printf 'revision=%s\n' "${TARGET_REVISION}"
    printf 'image=%s\n' "${TARGET_IMAGE}"
    printf 'previous_revision=%s\n' "${PREVIOUS_REVISION}"
    printf 'previous_image=%s\n' "${PREVIOUS_IMAGE}"
    printf 'deployed_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${tmp}"
  mv -f -- "${tmp}" "${STATE_FILE}"
}

database_head() {
  docker exec "${PG_BEFORE}" sh -ec \
    'exec psql --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" -v ON_ERROR_STOP=1 -At -c "SELECT version_num FROM alembic_version ORDER BY version_num"'
}

database_schema() {
  # PostgreSQL 17 pg_dump adds a random restrict key: exclude only those
  # guards, never actual DDL, before comparing schema fingerprints.
  docker exec "${PG_BEFORE}" sh -ec \
    'exec pg_dump --schema-only --no-owner --no-privileges --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' \
    | python3 -c 'import hashlib,re,sys; lines=(l for l in sys.stdin.buffer if not re.match(rb"\\(?:un)?restrict ",l)); print(hashlib.sha256(b"".join(lines)).hexdigest())'
}

rollback() {
  local status="${1:-$?}"
  local actual_head="" actual_schema="" compatible=0 failed=0
  trap - ERR INT TERM HUP
  set +e
  [[ "${status}" != "0" ]] || status=1
  if [[ "${ROLLBACK_ENABLED}" != "1" ]]; then
    exit "${status}"
  fi
  ROLLBACK_ENABLED=0
  printf '\nDéploiement V2 échoué (code %s). Évaluation du rollback applicatif sans downgrade.\n' "${status}" >&2

  if [[ "${RUNTIME_CHANGED}" != "1" ]]; then
    compatible=1
  else
    actual_head="$(database_head)" && actual_schema="$(database_schema)"
    if [[ $? == 0 && "${actual_head}" == "${PREVIOUS_DB_HEAD}" && "${actual_schema}" == "${PREVIOUS_SCHEMA}" ]]; then
      compatible=1
    elif [[ "${MIGRATION_STARTED}" == "1" && "${MIGRATION_MODE}" == "transactional-compatible" && "${actual_head}" == "${TARGET_DB_HEAD}" ]]; then
      compatible=1
    fi
  fi

  if [[ "${compatible}" != "1" ]]; then
    PRESERVE_RECOVERY=1
    # Stop any partially started target runtime; never run old code against an
    # unknown/incompatible schema and never automatically restore production data.
    "${COMPOSE[@]}" stop api worker scheduler >&2 || true
    printf 'Schéma inconnu/incompatible : aucun downgrade ni restauration automatique. Intervention opérateur requise.\nEnvironnement de récupération : %s\nSauvegarde vérifiée avant migration : %s\n' "${ENV_BACKUP}" "${BACKUP_LOG:-aucune migration commencée}" >&2
    exit "${status}"
  fi

  cp --preserve=mode,ownership,timestamps -- "${ENV_BACKUP}" "${ENV_FILE}" || failed=1
  repo_git checkout --detach "${PREVIOUS_REVISION}" >/dev/null 2>&1 || failed=1
  COMPOSE=(docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}")
  if [[ "${failed}" == 0 && "${RUNTIME_CHANGED}" == 1 ]]; then
    "${COMPOSE[@]}" up --detach --no-deps --force-recreate api worker scheduler ingress >&2 || failed=1
    if [[ "${failed}" == 0 ]]; then
      local recovered=0 expected_workers running_workers ingress_state
      expected_workers="$("${COMPOSE[@]}" config --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["services"]["worker"].get("deploy", {}).get("replicas", 1))')"
      [[ "${expected_workers}" =~ ^[1-9][0-9]*$ ]] || failed=1
      for attempt in $(seq 1 30); do
        running_workers="$("${COMPOSE[@]}" ps --status running -q worker | wc -l | tr -d ' ')"
        ingress_state="$(container_health ingress 2>/dev/null)"
        if [[ "$(container_health api 2>/dev/null)" == healthy ]] \
          && [[ "${running_workers}" == "${expected_workers}" ]] \
          && [[ "${ingress_state}" == running || "${ingress_state}" == healthy ]] \
          && [[ -n "$("${COMPOSE[@]}" ps --status running -q scheduler)" ]]; then
          recovered=1
          break
        fi
        sleep 2
      done
      [[ "${recovered}" == 1 ]] || failed=1
    fi
  fi
  if [[ "${failed}" != 0 ]]; then
    PRESERVE_RECOVERY=1
    printf 'Rollback applicatif incomplet : intervention opérateur requise ; environnement préservé : %s\n' "${ENV_BACKUP}" >&2
  elif [[ "${RUNTIME_CHANGED}" == 1 ]]; then
    printf 'Rollback applicatif vérifié ; schéma conservé, aucune donnée restaurée automatiquement.\n' >&2
  else
    printf 'Aucun runtime arrêté ; configuration précédente restaurée.\n' >&2
  fi
  "${COMPOSE[@]}" ps api worker scheduler ingress postgres redis qbittorrent newgreedy >&2
  exit "${status}"
}

on_error() {
  local status="$1"
  # A failing command substitution must unwind to the owning shell; only that
  # shell may restore services (ERR is inherited because errtrace is enabled).
  if (( BASH_SUBSHELL > 0 )); then exit "${status}"; fi
  rollback "${status}"
}

trap cleanup EXIT
trap 'on_error $?' ERR
trap 'rollback 130' INT
trap 'rollback 143' TERM
trap 'rollback 129' HUP

[[ ${EUID} -eq 0 ]] || fail "ce script doit être exécuté par root via sudo."
[[ $# -eq 3 ]] || fail "usage: deploy-world-of-seeds-v2-rise2 <revision> <sha256:digest> <github-actor>"

TARGET_REVISION="$1"
readonly IMAGE_DIGEST="$2"
readonly REGISTRY_USER="$3"
TARGET_IMAGE="${IMAGE_REPOSITORY}@${IMAGE_DIGEST}"

[[ "${TARGET_REVISION}" =~ ^[0-9a-f]{40}$ ]] || fail "revision Git invalide."
[[ "${IMAGE_DIGEST}" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "digest d'image invalide."
[[ "${REGISTRY_USER}" =~ ^[A-Za-z0-9-]{1,39}$ ]] || fail "identifiant GitHub invalide."

for path in "${PROJECT_DIR}" "${ENV_FILE}" "${COMPOSE_FILE}"; do
  [[ -e "${path}" ]] || fail "chemin requis absent: ${path}"
done
[[ -d "${PROJECT_DIR}/.git" ]] || fail "${PROJECT_DIR} n'est pas un checkout Git."
[[ -f "${ENV_FILE}" && ! -L "${ENV_FILE}" ]] || fail "fichier d'environnement invalide."
[[ $(stat -c '%U:%G' "${ENV_FILE}") == "root:root" ]] || fail "l'environnement doit appartenir à root:root."
ENV_MODE="$(stat -c '%a' "${ENV_FILE}")"
[[ "${ENV_MODE}" == "600" || "${ENV_MODE}" == "400" ]] || fail "l'environnement doit être en mode 600 ou 400."
mountpoint -q "${DATA_MOUNT}" || fail "le stockage V2 n'est pas monté sur ${DATA_MOUNT}."

for command in docker curl findmnt flock git mktemp mountpoint python3 stat; do
  command -v "${command}" >/dev/null || fail "commande requise absente: ${command}"
done
docker compose version >/dev/null

# Host-wide lock is held until EXIT, including recovery. No user-controlled path.
install -d -m 700 -o root -g root "${STATE_DIR}"
exec {DEPLOY_LOCK_FD}>"${STATE_DIR}/deployment.lock"
flock --nonblock "${DEPLOY_LOCK_FD}" || fail "un autre déploiement est déjà en cours."

[[ -z "$(repo_git status --porcelain --untracked-files=no)" ]] \
  || fail "le checkout Rise2 contient des modifications suivies."

repo_git fetch --quiet origin master:refs/remotes/origin/master
readonly REMOTE_MASTER="$(repo_git rev-parse refs/remotes/origin/master)"
[[ "${REMOTE_MASTER}" == "${TARGET_REVISION}" ]] \
  || fail "la revision demandée n'est pas le HEAD actuel de master."
repo_git cat-file -e "${TARGET_REVISION}^{commit}"

PREVIOUS_REVISION="$(repo_git rev-parse HEAD)"
repo_git merge-base --is-ancestor "${PREVIOUS_REVISION}" "${TARGET_REVISION}" \
  || fail "le déploiement refuse un historique non fast-forward."

readonly BLOCKED_CHANGES="$(repo_git diff --name-only "${PREVIOUS_REVISION}..${TARGET_REVISION}" -- \
  scripts/rise2_v2_preflight.sh \
  scripts/validate_compose_v2_rise2.py \
  scripts/rise2_v2_storage_smoke.sh \
  scripts/rise2_v2_database_backup.py \
  deploy/deploy-world-of-seeds-v2-rise2 \
  deploy/world-of-seeds-v2-database-backup.service \
  deploy/world-of-seeds-v2-database-backup.timer \
  deploy/world-of-seeds-v2-smart-metrics.service \
  deploy/world-of-seeds-v2-smart-metrics.timer \
  deploy/compose.rise2.v2.yaml \
  deploy/qbittorrent.rise2.conf \
  deploy/world-of-seeds-v2-rise2.service \
  scripts/rise2_v2_qb_bootstrap.py \
  scripts/rise2_v2_qb_probe.py \
  scripts/rise2_v2_qb_reconcile.sh \
  scripts/rise2_v2_qb_reconcile.awk \
  scripts/rise2_v2_newgreedy_policy.py \
  scripts/rise2_v2_newgreedy_smoke.sh)"
[[ -z "${BLOCKED_CHANGES}" ]] || fail "changement d'infrastructure sensible détecté; déploiement manuel requis."

readonly EXPECTED_VERSION="$(repo_git show "${TARGET_REVISION}:VERSION" | tr -d '\r\n')"
[[ "${EXPECTED_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] \
  || fail "VERSION cible invalide."

PREVIOUS_IMAGE="$(env_value WOS_V2_IMAGE)"
[[ "${PREVIOUS_IMAGE}" =~ ^${IMAGE_REPOSITORY}@sha256:[0-9a-f]{64}$ ]] \
  || fail "image précédente non immuable ou inattendue."

IFS= read -r REGISTRY_TOKEN || fail "jeton GHCR absent sur l'entrée standard."
[[ ${#REGISTRY_TOKEN} -ge 20 && ${#REGISTRY_TOKEN} -le 4096 ]] || fail "jeton GHCR invalide."

DOCKER_CONFIG_DIR="$(mktemp -d /tmp/world-of-seeds-v2-docker-config.XXXXXX)"
chmod 700 "${DOCKER_CONFIG_DIR}"
export DOCKER_CONFIG="${DOCKER_CONFIG_DIR}"
printf '%s' "${REGISTRY_TOKEN}" \
  | docker login ghcr.io --username "${REGISTRY_USER}" --password-stdin >/dev/null
unset REGISTRY_TOKEN

docker pull "${TARGET_IMAGE}" >/dev/null
docker pull "${PREVIOUS_IMAGE}" >/dev/null

readonly ACTUAL_REVISION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${TARGET_IMAGE}")"
readonly ACTUAL_VERSION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${TARGET_IMAGE}")"
[[ "${ACTUAL_REVISION}" == "${TARGET_REVISION}" ]] || fail "label OCI revision incorrect."
[[ "${ACTUAL_VERSION}" == "${EXPECTED_VERSION}" ]] || fail "label OCI version incorrect."

PREVIOUS_DB_HEAD="$(docker run --rm --pull=never --entrypoint alembic \
  --workdir /app/backend "${PREVIOUS_IMAGE}" -c alembic.ini heads 2>/dev/null \
  | awk 'NF {print $1}')"
[[ "${PREVIOUS_DB_HEAD}" =~ ^[0-9A-Za-z_]+$ ]] || fail "impossible de déterminer le head Alembic précédent."
TARGET_DB_HEAD="$(docker run --rm --network=none --pull=never --entrypoint alembic   --workdir /app/backend "${TARGET_IMAGE}" -c alembic.ini heads 2>/dev/null)"
TARGET_DB_HEAD="$(printf '%s\n' "${TARGET_DB_HEAD}" | awk 'NF {print $1}')"
[[ "${TARGET_DB_HEAD}" =~ ^[0-9A-Za-z_]+$ ]] || fail "le schéma cible doit avoir un head unique."


ENV_BACKUP="$(mktemp /etc/world-of-seeds-v2/.environment.pre-deploy.XXXXXX)"
cp --preserve=mode,ownership,timestamps -- "${ENV_FILE}" "${ENV_BACKUP}"
chmod 600 "${ENV_BACKUP}"
ROLLBACK_ENABLED=1

repo_git checkout --detach "${TARGET_REVISION}" >/dev/null
set_env_image "${TARGET_IMAGE}"

"${PROJECT_DIR}/scripts/rise2_v2_preflight.sh" "${ENV_FILE}"
COMPOSE=(docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}")
"${COMPOSE[@]}" config --quiet

readonly QB_BEFORE="$("${COMPOSE[@]}" ps -q qbittorrent)"
readonly NG_BEFORE="$("${COMPOSE[@]}" ps -q newgreedy)"
readonly PG_BEFORE="$("${COMPOSE[@]}" ps -q postgres)"
readonly REDIS_BEFORE="$("${COMPOSE[@]}" ps -q redis)"
for cid in "${QB_BEFORE}" "${NG_BEFORE}" "${PG_BEFORE}" "${REDIS_BEFORE}"; do
  [[ -n "${cid}" ]] || fail "un service persistant requis est absent."
done

docker exec "${PG_BEFORE}" sh -ec 'exec pg_isready --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' >/dev/null
readonly ACTUAL_DB_HEAD="$(database_head)"
[[ "${ACTUAL_DB_HEAD}" == "${PREVIOUS_DB_HEAD}" ]] || fail "le schéma réel ne correspond pas à l’image précédente; intervention opérateur requise."
PREVIOUS_SCHEMA="$(database_schema)"
[[ "${PREVIOUS_SCHEMA}" =~ ^[0-9a-f]{64}$ ]] || fail "empreinte du schéma invalide."

if [[ "${TARGET_DB_HEAD}" != "${PREVIOUS_DB_HEAD}" ]]; then
  # Every automatic schema transition needs an explicit reviewed transactional
  # policy. Non-transactional/unknown migrations require a separate operator plan.
  MIGRATION_MODE="$(repo_git show "${TARGET_REVISION}:deploy/migration-policy.json" \
    | python3 -c 'import json,sys; p=json.load(sys.stdin); entry=p["upgrades"][sys.argv[1]+"->"+sys.argv[2]]; assert p["schema"]==1 and entry["transactional"] is True and type(entry["backward_compatible"]) is bool; print("transactional-compatible" if entry["backward_compatible"] else "transactional-forward-only")' "${PREVIOUS_DB_HEAD}" "${TARGET_DB_HEAD}")"
  BACKUP_HELPER="$(mktemp "${STATE_DIR}/.backup-helper.XXXXXX.py")"
  # Execute the previously deployed, reviewed helper, never a target-supplied hook.
  repo_git show "${PREVIOUS_REVISION}:scripts/rise2_v2_database_backup.py" >"${BACKUP_HELPER}"
  chmod 600 "${BACKUP_HELPER}"
  BACKUP_LOG="$(mktemp "${STATE_DIR}/pre-migration-backup.XXXXXX.log")"
  chmod 600 "${BACKUP_LOG}"
  python3 "${BACKUP_HELPER}" backup --recipient-file /etc/world-of-seeds-v2/backup-recipient \
    >"${BACKUP_LOG}" || fail "sauvegarde chiffrée/restauration isolée échouée ; runtime précédent conservé."
  cat "${BACKUP_LOG}"
fi

# Mark intent BEFORE stop: stop itself may partially succeed before failing.
RUNTIME_CHANGED=1
"${COMPOSE[@]}" stop api worker scheduler
# Seal a quiescent schema fingerprint too (no application DDL should race this).
[[ "$(database_head)" == "${PREVIOUS_DB_HEAD}" && "$(database_schema)" == "${PREVIOUS_SCHEMA}" ]] \
  || fail "schéma modifié pendant le préflight ; intervention opérateur requise."
if [[ "${TARGET_DB_HEAD}" != "${PREVIOUS_DB_HEAD}" ]]; then
  MIGRATION_STARTED=1
  "${COMPOSE[@]}" run --rm --no-deps migrate
  MIGRATION_APPLIED=1
  [[ "$(database_head)" == "${TARGET_DB_HEAD}" ]] || fail "head Alembic réel incorrect après migration."
fi

"${COMPOSE[@]}" up --detach --no-deps --force-recreate \
  api worker scheduler
"${COMPOSE[@]}" up --detach --no-deps --force-recreate ingress

for attempt in $(seq 1 60); do
  [[ "$(container_health api 2>/dev/null || true)" == "healthy" ]] && break
  sleep 2
done
[[ "$(container_health api)" == "healthy" ]] || fail "API non healthy après déploiement."

readonly EXPECTED_WORKERS="$("${COMPOSE[@]}" config --format json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["services"]["worker"].get("deploy", {}).get("replicas", 1))')"
RUNNING_WORKERS=0
RUNNING_SCHEDULERS=0
for attempt in $(seq 1 60); do
  RUNNING_WORKERS="$("${COMPOSE[@]}" ps --status running -q worker | wc -l | tr -d ' ')"
  RUNNING_SCHEDULERS="$("${COMPOSE[@]}" ps --status running -q scheduler | wc -l | tr -d ' ')"
  [[ "${RUNNING_WORKERS}" == "${EXPECTED_WORKERS}" && "${RUNNING_SCHEDULERS}" == "1" ]] && break
  sleep 2
done
[[ "${RUNNING_WORKERS}" == "${EXPECTED_WORKERS}" ]] || fail "workers incomplets: ${RUNNING_WORKERS}/${EXPECTED_WORKERS}."
[[ "${RUNNING_SCHEDULERS}" == "1" ]] || fail "scheduler non disponible."

for service in postgres redis qbittorrent newgreedy; do
  [[ "$(container_health "${service}")" == "healthy" ]] || fail "${service} non healthy après déploiement."
done

[[ "$("${COMPOSE[@]}" ps -q qbittorrent)" == "${QB_BEFORE}" ]] || fail "qBittorrent a été recréé."
[[ "$("${COMPOSE[@]}" ps -q newgreedy)" == "${NG_BEFORE}" ]] || fail "NewGreedy a été recréé."
[[ "$("${COMPOSE[@]}" ps -q postgres)" == "${PG_BEFORE}" ]] || fail "PostgreSQL a été recréé."
[[ "$("${COMPOSE[@]}" ps -q redis)" == "${REDIS_BEFORE}" ]] || fail "Redis a été recréé."

readonly API_CID="$("${COMPOSE[@]}" ps -q api)"
readonly RUNNING_IMAGE="$(docker inspect --format '{{.Config.Image}}' "${API_CID}")"
readonly RUNNING_REVISION="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${API_CID}")"
[[ "${RUNNING_IMAGE}" == "${TARGET_IMAGE}" ]] || fail "l'API n'exécute pas le digest demandé."
[[ "${RUNNING_REVISION}" == "${TARGET_REVISION}" ]] || fail "l'API n'exécute pas la revision demandée."

docker exec -i "${API_CID}" python - <<'PY'
import urllib.request
for path in ("/api/v1/health/live", "/api/v1/health/ready"):
    with urllib.request.urlopen("http://127.0.0.1:8000" + path, timeout=5) as response:
        assert response.status == 200
PY

readonly PUBLIC_HOST_RAW="$(env_value WOS_V2_PUBLIC_HOST)"
readonly PUBLIC_HOST="$(python3 - "${PUBLIC_HOST_RAW}" <<'PYHOST'
import sys
hosts = [item.strip() for item in sys.argv[1].split(",") if item.strip()]
if not hosts:
    raise SystemExit(1)
print(hosts[-1])
PYHOST
)"
[[ -n "${PUBLIC_HOST}" ]] || fail "host public V2 absent."
readonly HTTPS_CODE="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
  --connect-timeout 5 --max-time 15 "https://${PUBLIC_HOST}/api/v1/health/ready")"
[[ "${HTTPS_CODE}" == "200" ]] || fail "readiness HTTPS production invalide: ${HTTPS_CODE}."

write_state
ROLLBACK_ENABLED=0
trap - ERR INT TERM HUP
printf 'World of Seeds V2 déployé avec succès : revision=%s image=%s\n' \
  "${TARGET_REVISION}" "${TARGET_IMAGE}"

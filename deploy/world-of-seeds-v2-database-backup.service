[Unit]
Description=World of Seeds V2 encrypted PostgreSQL backup and isolated restore check
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/world-of-seeds-v2/scripts/rise2_v2_database_backup.py backup --recipient-file /etc/world-of-seeds-v2/backup-recipient
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

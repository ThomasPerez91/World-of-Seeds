{
	admin off
}

{$WOS_V2_PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
	request_body {
		max_size 20MB
	}
	reverse_proxy api:8000
}

{$WOS_V2_GRAFANA_HOST} {
	encode zstd gzip
	reverse_proxy grafana:3000
}

[Unit]
Description=World of Seeds restricted application restart
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/world-of-seeds-app-restart
RuntimeDirectory=world-of-seeds-app
RuntimeDirectoryMode=0700
UMask=0027
TimeoutStartSec=180
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/world-of-seeds
ReadWritePaths=/srv/seedbox/.wos-control/wos
ReadWritePaths=/srv/seedbox/.wos-control/wos-status
ReadWritePaths=/run/world-of-seeds-app
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
SystemCallArchitectures=native

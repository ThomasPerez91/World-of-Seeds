        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "wos_http_download_telemetry_fresh{job=\"wos-api\"} * on (job, instance) wos_http_download_telemetry_configured{job=\"wos-api\"} + on (job, instance) (wos_http_download_telemetry_configured{job=\"wos-api\"} - 1)",
          "refId": "A",
          "legendFormat": "Mesure réseau fraîche",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": -1,
          "noValue": "Sans données",
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Périmée / absente",
                  "color": "orange"
                },
                "1": {
                  "text": "Fraîche",
                  "color": "green"
                },
                "-1": {
                  "text": "Collecte désactivée",
                  "color": "gray"

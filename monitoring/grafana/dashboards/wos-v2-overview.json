{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "stat", "title": "Services disponibles", "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(up)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "stat", "title": "Tâches en attente", "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "wos_jobs{state=\"queued\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "stat", "title": "Âge de la file", "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "wos_job_queue_oldest_age_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "stat", "title": "Stockage libre", "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "wos_storage_bytes{kind=\"disk_free\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Requêtes API", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (route, status_class) (rate(wos_api_requests_total[5m]))", "legendFormat": "{{route}} {{status_class}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Latence API p95", "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(wos_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Tâches durables par état", "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "wos_jobs", "legendFormat": "{{state}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Dépendances", "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "wos_redis_up", "legendFormat": "Redis", "refId": "A"},
        {"expr": "wos_qbittorrent_up", "legendFormat": "qBittorrent", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "CPU hôte", "id": 9,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Mémoire hôte", "id": 10,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "CPU conteneurs", "id": 11,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["world-of-seeds", "v2"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "World of Seeds V2 — Vue opérationnelle",
  "uid": "world-of-seeds-v2",

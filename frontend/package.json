{
  "name": "world-of-seeds-frontend",
  "private": true,
  "version": "2.4.8",
  "type": "module",
  "scripts": {
    "build": "npm run check && vite build",
    "check": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "country-flag-icons": "1.6.20",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.33",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.10"
  }
}

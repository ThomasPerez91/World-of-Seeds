# Copiez ce fichier vers .env et remplacez toutes les valeurs d'exemple.
POSTGRES_DB=world_of_seeds
POSTGRES_USER=world_of_seeds
POSTGRES_PASSWORD=replace-with-a-long-random-password

# UID/GID ayant accès à /srv/seedbox sur l'hôte.
APP_UID=1000
APP_GID=1000
SEEDBOX_HOST_PATH=/srv/seedbox

WOS_ENVIRONMENT=production
# Uvicorn attend une valeur en minuscules : critical, error, warning, info, debug ou trace.
WOS_LOG_LEVEL=info
# L'accès initial se fait en HTTP au travers du tunnel SSH. Passez à true avec HTTPS.
WOS_COOKIE_SECURE=false
WOS_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# API internes accessibles uniquement par le réseau Docker torrent-internal.
WOS_NEWGREEDY_URL=http://newgreedy:8080
WOS_QBITTORRENT_URL=http://qbittorrent:8080
WOS_QBITTORRENT_USERNAME=replace-with-qbittorrent-webui-user
WOS_QBITTORRENT_PASSWORD=replace-with-qbittorrent-webui-password
# qBittorrent doit monter /srv/seedbox sur ce même chemin interne.
WOS_QBITTORRENT_DATA_ROOT=/data

# Secret C411 utilisé à la place de toute passkey contenue dans un upload utilisateur.
WOS_C411_PASSKEY=replace-with-wos-c411-passkey
WOS_C411_TRACKER_HOSTS=["c411.org","tk.c411.tw"]

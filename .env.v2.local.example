# Valeurs strictement locales et factices. Ne réutilisez aucun secret de déploiement.
WOS_V2_POSTGRES_DB=world_of_seeds_v2_local
WOS_V2_POSTGRES_USER=world_of_seeds_v2_local
WOS_V2_POSTGRES_PASSWORD=local-only-not-a-production-secret

# Requis par l'interpolation du socle, mais remplacé par un volume nommé dans le profil local.
WOS_V2_STORAGE_HOST_PATH=/tmp/world-of-seeds-v2-local-unused
WOS_V2_API_PORT=28081
WOS_V2_ENVIRONMENT=development
WOS_V2_LOG_LEVEL=info
WOS_V2_COOKIE_SECURE=false
WOS_V2_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Copiez ce fichier vers .env.v2 et remplacez toutes les valeurs d'exemple.
# Cette configuration est réservée à la pile locale V2.
WOS_V2_POSTGRES_DB=world_of_seeds_v2
WOS_V2_POSTGRES_USER=world_of_seeds_v2
WOS_V2_POSTGRES_PASSWORD=replace-with-a-distinct-long-random-password

# Racine V2 dédiée. Ne réutilisez pas le stockage de production V1.
WOS_V2_STORAGE_HOST_PATH=/srv/world-of-seeds-v2
WOS_V2_APP_UID=1000
WOS_V2_APP_GID=1000

WOS_V2_API_PORT=28081
WOS_V2_ENVIRONMENT=development
WOS_V2_LOG_LEVEL=info
WOS_V2_COOKIE_SECURE=false
WOS_V2_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Registre JSON secret fourni au runtime. Laissez vide en développement sans intégrations.
WOS_V2_INTEGRATION_ACCOUNTS_JSON=

# Monitoring optionnel (compose.v2.monitoring.yaml). Utilisez des secrets distincts en production.
WOS_V2_GRAFANA_PORT=23000
WOS_V2_GRAFANA_ADMIN_USER=replace-with-a-monitoring-admin
WOS_V2_GRAFANA_ADMIN_PASSWORD=replace-with-a-distinct-long-random-password
WOS_V2_PROMETHEUS_RETENTION=15d
